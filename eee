--===============================================
-- HITBOX EXPANDER SYSTEM (Simple & Proven Method)
--===============================================

local ExpandedHitboxes = {}
local OriginalSizes = {}
local TrackedNPCs = {}
local HitboxExpanderActive = false

local function expandHitboxOnce(character)
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Store original size only once
    if not OriginalSizes[character] then
        OriginalSizes[character] = hrp.Size
    end
    
    -- Directly modify HumanoidRootPart (proven method from Infinite Yield)
    hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
    hrp.Transparency = Settings.HitboxTransparency
    -- DO NOT change CanCollide - leave it as the game set it
    
    ExpandedHitboxes[character] = true
end

local function resetHitboxOnce(character)
    if not character then return end
    if not ExpandedHitboxes[character] then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp and OriginalSizes[character] then
        hrp.Size = OriginalSizes[character]
        hrp.Transparency = 1
    end
    
    OriginalSizes[character] = nil
    ExpandedHitboxes[character] = nil
end

local function isNPCModel(model)
    if not model or not model:IsA("Model") then return false end
    
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Check if it's a player character
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then
            return false
        end
    end
    
    return true
end

local function setupNPCTracking(model)
    if TrackedNPCs[model] then return end
    if not isNPCModel(model) then return end
    
    TrackedNPCs[model] = true
    
    if HitboxExpanderActive and Settings.ExpandNPCHitbox then
        expandHitboxOnce(model)
    end
end

local function initialNPCScan()
    -- One-time scan for existing NPCs
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") then
            setupNPCTracking(model)
        end
    end
end

local function expandAllCurrent()
    -- Expand player hitboxes
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            expandHitboxOnce(player.Character)
        end
    end
    
    -- Expand NPC hitboxes if enabled
    if Settings.ExpandNPCHitbox then
        for model, _ in pairs(TrackedNPCs) do
            if model and model.Parent then
                expandHitboxOnce(model)
            end
        end
    end
end

local function resetAllHitboxes()
    for character, _ in pairs(ExpandedHitboxes) do
        resetHitboxOnce(character)
    end
end

local function startHitboxExpander()
    if HitboxExpanderActive then return end
    HitboxExpanderActive = true
    
    -- Initial scan for NPCs (one time only)
    if Settings.ExpandNPCHitbox then
        initialNPCScan()
    end
    
    -- Expand all current targets
    expandAllCurrent()
    
    -- Start periodic scan for new NPCs (runs every 1 second)
    task.spawn(function()
        while HitboxExpanderActive do
            task.wait(1)
            if not HitboxExpanderActive then break end
            
            -- Always scan for player hitboxes
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    expandHitboxOnce(player.Character)
                end
            end
            
            -- Scan for NPC hitboxes if enabled
            if Settings.ExpandNPCHitbox then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        local hrp = obj:FindFirstChild("HumanoidRootPart")
                        if humanoid and hrp then
                            -- Check it's not a player character
                            local isPlayer = false
                            for _, player in ipairs(Players:GetPlayers()) do
                                if player.Character == obj then
                                    isPlayer = true
                                    break
                                end
                            end
                            if not isPlayer then
                                TrackedNPCs[obj] = true
                                expandHitboxOnce(obj)
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function stopHitboxExpander()
    HitboxExpanderActive = false
    resetAllHitboxes()
end

local function updateHitboxSize()
    -- Update size for already expanded hitboxes
    for character, _ in pairs(ExpandedHitboxes) do
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
            hrp.Transparency = Settings.HitboxTransparency
        end
    end
end

-- Event: New model added to workspace (for NPCs)
-- Listen for both Models and Humanoids being added
workspace.DescendantAdded:Connect(function(descendant)
    if not HitboxExpanderActive then return end
    if not Settings.ExpandNPCHitbox then return end
    
    -- If a Model is added, check it
    if descendant:IsA("Model") then
        task.spawn(function()
            -- Wait a bit for children to be parented
            task.wait(0.1)
            if not descendant or not descendant.Parent then return end
            if not HitboxExpanderActive then return end
            
            -- Check if it's a valid NPC now
            local humanoid = descendant:FindFirstChildOfClass("Humanoid")
            local hrp = descendant:FindFirstChild("HumanoidRootPart")
            
            if humanoid and hrp then
                -- It's ready, expand it
                if not TrackedNPCs[descendant] and isNPCModel(descendant) then
                    TrackedNPCs[descendant] = true
                    expandHitboxOnce(descendant)
                end
            else
                -- Wait longer for parts to appear
                local waitTime = 0
                while (not humanoid or not hrp) and waitTime < 3 do
                    task.wait(0.2)
                    waitTime = waitTime + 0.2
                    humanoid = descendant:FindFirstChildOfClass("Humanoid")
                    hrp = descendant:FindFirstChild("HumanoidRootPart")
                    if not descendant or not descendant.Parent then return end
                    if not HitboxExpanderActive then return end
                end
                
                if humanoid and hrp and not TrackedNPCs[descendant] and isNPCModel(descendant) then
                    TrackedNPCs[descendant] = true
                    expandHitboxOnce(descendant)
                end
            end
        end)
    end
    
    -- If a Humanoid is added, check its parent Model
    if descendant:IsA("Humanoid") then
        task.spawn(function()
            task.wait(0.1)
            if not descendant or not descendant.Parent then return end
            if not HitboxExpanderActive then return end
            
            local model = descendant.Parent
            if not model or not model:IsA("Model") then return end
            if TrackedNPCs[model] then return end
            
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if not hrp then
                -- Wait for HumanoidRootPart
                local waitTime = 0
                while not hrp and waitTime < 2 do
                    task.wait(0.1)
                    waitTime = waitTime + 0.1
                    hrp = model:FindFirstChild("HumanoidRootPart")
                    if not model or not model.Parent then return end
                    if not HitboxExpanderActive then return end
                end
            end
            
            if hrp and isNPCModel(model) then
                TrackedNPCs[model] = true
                expandHitboxOnce(model)
            end
        end)
    end
    
    -- If a HumanoidRootPart is added, check its parent Model
    if descendant.Name == "HumanoidRootPart" and descendant:IsA("BasePart") then
        task.spawn(function()
            task.wait(0.1)
            if not descendant or not descendant.Parent then return end
            if not HitboxExpanderActive then return end
            
            local model = descendant.Parent
            if not model or not model:IsA("Model") then return end
            if TrackedNPCs[model] then return end
            
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if not humanoid then
                -- Wait for Humanoid
                local waitTime = 0
                while not humanoid and waitTime < 2 do
                    task.wait(0.1)
                    waitTime = waitTime + 0.1
                    humanoid = model:FindFirstChildOfClass("Humanoid")
                    if not model or not model.Parent then return end
                    if not HitboxExpanderActive then return end
                end
            end
            
            if humanoid and isNPCModel(model) then
                TrackedNPCs[model] = true
                expandHitboxOnce(model)
            end
        end)
    end
end)

