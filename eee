-- FLING PLAYER SYSTEM
--===============================================

local FlingConnection = nil
local FlingActive = false
local FlingTargetPlayer = nil

local function getPlayerList()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end
    end
    return list
end

local function flingPlayer(targetPlayer)
    if not targetPlayer then return end
    
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end
    
    local myChar = LocalPlayer.Character
    if not myChar then return end
    
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    
    local humanoid = myChar:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    -- Store original values
    local originalWalkSpeed = humanoid.WalkSpeed
    local originalJumpPower = humanoid.JumpPower
    local originalHipHeight = humanoid.HipHeight
    
    FlingActive = true
    
    -- Disable collision on our character
    for _, part in ipairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    
    -- Set up for fling
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    
    -- Fling loop
    local flingStartTime = tick()
    local flingDuration = 1.5
    
    FlingConnection = RunService.Heartbeat:Connect(function()
        if not FlingActive or tick() - flingStartTime > flingDuration then
            -- Stop fling
            FlingActive = false
            if FlingConnection then
                FlingConnection:Disconnect()
                FlingConnection = nil
            end
            
            -- Restore values
            if humanoid then
                humanoid.WalkSpeed = originalWalkSpeed
                humanoid.JumpPower = originalJumpPower
                humanoid.HipHeight = originalHipHeight
            end
            
            -- Re-enable collision
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
            return
        end
        
        -- Get fresh references
        targetChar = targetPlayer.Character
        if not targetChar then return end
        targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end
        
        -- Teleport to target and apply high velocity for fling
        myHRP.CFrame = targetHRP.CFrame
        myHRP.Velocity = Vector3.new(math.random(-500, 500), math.random(400, 600), math.random(-500, 500))
        myHRP.RotVelocity = Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
        
        -- Also set angular velocity for more chaos
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Velocity = Vector3.new(math.random(-300, 300), math.random(200, 400), math.random(-300, 300))
                part.RotVelocity = Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
            end
        end
    end)
end

local function stopFling()
    FlingActive = false
    if FlingConnection then
        FlingConnection:Disconnect()
        FlingConnection = nil
    end
end

