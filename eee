local function makeThingExist(className, properties)
    local whatWeJustMade = Instance.new(className)
    for property, value in pairs(properties) do
        if property ~= "Parent" then
            pcall(function()
                whatWeJustMade[property] = value
            end)
        end
    end
    if properties.Parent then
        whatWeJustMade.Parent = properties.Parent
    end
    return whatWeJustMade
end

local function smoothMoveGoWoosh(instance, properties, duration, easingStyle, easingDirection)
    local tweenInfoYay = TweenInfo.new(duration or 0.2, easingStyle or Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out)
    local tweenGoVroom = oMgThisTweenServiceIsSoCool:Create(instance, tweenInfoYay, properties)
    tweenGoVroom:Play()
    return tweenGoVroom
end

local function makeDraggableCuzWeCan(frame, handle)
    local amIDragging = false
    local whatAmIDragging
    local whereDidIStart
    local whereWasIBefore
    
    handle = handle or frame
    
    local function updatePositionYay(input)
        local howMuchDidIMove = input.Position - whereDidIStart
        frame.Position = UDim2.new(whereWasIBefore.X.Scale, whereWasIBefore.X.Offset + howMuchDidIMove.X, whereWasIBefore.Y.Scale, whereWasIBefore.Y.Offset + howMuchDidIMove.Y)
    end
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            amIDragging = true
            whereDidIStart = input.Position
            whereWasIBefore = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    amIDragging = false
                end
            end)
        end
    end)
    
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            whatAmIDragging = input
        end
    end)
    
    thisInputServiceGoesHard.InputChanged:Connect(function(input)
        if input == whatAmIDragging and amIDragging then
            updatePositionYay(input)
        end
    end)
end

