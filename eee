        -- Clean up ESP
        for _, items in pairs(Drawings) do
            for k, d in pairs(items) do
                if k == "Chams" and type(d) == "table" then
                    for _, adorn in pairs(d) do
                        if adorn and adorn.Destroy then pcall(function() adorn:Destroy() end) end
                    end
                elseif k == "Highlight" and d then
                    pcall(function() d:Destroy() end)
                elseif d and d.Remove then
                    pcall(function() d:Remove() end)
                end
            end
        end
        -- Clean up Silent Aim
        if fov_circle then fov_circle:Remove() end
        if target_highlight then target_highlight:Destroy() end
        if aimbot_fov_circle then aimbot_fov_circle:Remove() end
        Window:Destroy()
    end
})

