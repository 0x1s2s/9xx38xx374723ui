-- No Fall Damage (Universal - Multiple Methods)
local NoFallDamageConnections = {}

local function setupNoFallDamage(char)
    -- Clean up old connections
    for _, conn in pairs(NoFallDamageConnections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    NoFallDamageConnections = {}
    
    if not Settings.NoFallDamage then return end
    
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    
    -- Method 1: Disable FallingDown and Freefall states
    NoFallDamageConnections.stateChanged = humanoid.StateChanged:Connect(function(old, new)
        if not Settings.NoFallDamage then return end
        
        if new == Enum.HumanoidStateType.FallingDown then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
    
    -- Method 2: Disable specific states entirely
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end)
    
    -- Method 3: Monitor velocity and cushion landing
    local lastYVelocity = 0
    NoFallDamageConnections.velocityCheck = RunService.Heartbeat:Connect(function()
        if not Settings.NoFallDamage then return end
        if not hrp or not hrp.Parent then return end
        
        local currentYVelocity = hrp.Velocity.Y
        
        -- Detect high-speed landing (falling fast then suddenly stopping)
        if lastYVelocity < -50 and currentYVelocity > -10 then
            -- We just landed hard - prevent damage by changing state
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Landed)
            end)
        end
        
        lastYVelocity = currentYVelocity
    end)
    
    -- Method 4: Prevent ragdoll/physics states
    NoFallDamageConnections.freefallCheck = humanoid.FreeFalling:Connect(function(active)
        if not Settings.NoFallDamage then return end
        
        -- When freefall ends, ensure we land safely
        if not active then
            task.defer(function()
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.Landed)
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end)
        end
    end)
    
    -- Method 5: Directly monitor and heal any fall damage
    local lastHealth = humanoid.Health
    NoFallDamageConnections.healthCheck = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if not Settings.NoFallDamage then return end
        
        local currentHealth = humanoid.Health
        local damage = lastHealth - currentHealth
        
        -- If we took damage while in a falling-related state, heal it back
        if damage > 0 then
            local state = humanoid:GetState()
            if state == Enum.HumanoidStateType.Freefall or 
               state == Enum.HumanoidStateType.FallingDown or
               state == Enum.HumanoidStateType.Landed then
                -- This was likely fall damage - restore health
                task.defer(function()
                    humanoid.Health = math.min(lastHealth, humanoid.MaxHealth)
                end)
            end
        end
        
        lastHealth = humanoid.Health
    end)
end

local function disableNoFallDamage()
    for _, conn in pairs(NoFallDamageConnections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    NoFallDamageConnections = {}
    
    -- Re-enable states
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            end)
        end
    end
end

