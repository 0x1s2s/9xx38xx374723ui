local function getClosestPlayerAimbot()
    local Closest = nil
    local ClosestDistance = Settings.AimbotFOVRadius
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player == LocalPlayer then continue end
        if Settings.AimbotTeamCheck and Player.Team == LocalPlayer.Team then continue end

        local Character = Player.Character
        if not Character then continue end
        
        if Settings.AimbotVisibleCheck and not IsPlayerVisibleAimbot(Player) then continue end

        local TargetPart = Character:FindFirstChild(Settings.AimbotTargetPart)
