                        end
                    else
                        items.Tracer.Visible = false
                    end
                else
                    for k,d in pairs(items) do
                        if k=="Highlight" and d then d.Enabled=false
                        elseif k=="Chams" and type(d)=="table" then
                            for _,adorn in pairs(d) do if adorn and adorn.Destroy then pcall(function() adorn:Destroy() end) end end
                            items.Chams={}
                        elseif k=="Tracer" and d then d.Visible=false
                        elseif d and d.Visible~=nil then d.Visible=false end
                    end
                end
            end
        else
            for k,d in pairs(items) do
                if k=="Highlight" and d then d.Enabled=false
                elseif k=="Chams" and type(d)=="table" then
                    for _,adorn in pairs(d) do if adorn and adorn.Destroy then pcall(function() adorn:Destroy() end) end end
                    items.Chams={}
                elseif k=="Tracer" and d then d.Visible=false
