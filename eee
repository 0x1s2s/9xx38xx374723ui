local function createDamageIndicator(position, damage, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 100, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = game:GetService("CoreGui")
    
    local attachment = Instance.new("Attachment")
    attachment.WorldPosition = position
    attachment.Parent = workspace.Terrain
    billboard.Adornee = attachment
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "-" .. tostring(math.floor(damage))
    textLabel.TextColor3 = color or Settings.DamageCounterColor
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 20
    textLabel.TextScaled = false
    textLabel.Parent = billboard
    
    -- Animation
    task.spawn(function()
        local startPos = position
        local startTime = tick()
        local duration = 1.5
        
        while tick() - startTime < duration do
            local elapsed = tick() - startTime
            local progress = elapsed / duration
            
            -- Move up and fade out
            local newY = startPos.Y + (progress * 3)
            attachment.WorldPosition = Vector3.new(startPos.X + math.sin(elapsed * 5) * 0.3, newY, startPos.Z)
            textLabel.TextTransparency = progress
            textLabel.TextStrokeTransparency = progress
            
            -- Scale up slightly then down
            local scale = 1 + math.sin(progress * math.pi) * 0.3
            textLabel.TextSize = 20 * scale
            
            task.wait()
        end
        
        billboard:Destroy()
        attachment:Destroy()
    end)
end

local function setupDamageTracking(player)
    if player == LocalPlayer then return end
    
    local function onCharacterAdded(char)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        
        -- Store initial health
        DamageTracking[player] = humanoid.Health
        
        -- Disconnect old connection if exists
        if DamageCounterConnections[player] then
            DamageCounterConnections[player]:Disconnect()
        end
        
        DamageCounterConnections[player] = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
            if not Settings.DamageCounterEnabled then return end
            
            local previousHealth = DamageTracking[player] or humanoid.MaxHealth
            local currentHealth = humanoid.Health
            local damage = previousHealth - currentHealth
            
            -- Only show damage (not healing) and only significant amounts
            if damage > 0.1 then
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                if root then
                    -- Add randomness to position
                    local pos = root.Position + Vector3.new(
                        math.random(-10, 10) / 10,
                        math.random(5, 15) / 10,
                        math.random(-10, 10) / 10
                    )
                    createDamageIndicator(pos, damage, Settings.DamageCounterColor)
                end
            end
            
            DamageTracking[player] = currentHealth
        end)
    end
    
    if player.Character then
        onCharacterAdded(player.Character)
    end
    player.CharacterAdded:Connect(onCharacterAdded)
end

