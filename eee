local originalLightingProps = {}

local function applyCustomSky(skyType)
    -- Store original sky if not stored
    if not originalSky then
        originalSky = Lighting:FindFirstChildOfClass("Sky")
        originalLightingProps = {
            ClockTime = Lighting.ClockTime,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient
        }
    end
    
    -- Remove custom sky if exists
    if customSkyInstance then
        customSkyInstance:Destroy()
        customSkyInstance = nil
    end
    
    if skyType == "Default" or not SkyPresets[skyType] then
        -- Restore original
        if originalSky then
            originalSky.Parent = Lighting
        end
        Lighting.ClockTime = originalLightingProps.ClockTime or 14
        Lighting.Ambient = originalLightingProps.Ambient or Color3.fromRGB(127, 127, 127)
        Lighting.OutdoorAmbient = originalLightingProps.OutdoorAmbient or Color3.fromRGB(127, 127, 127)
        return
    end
    
    local preset = SkyPresets[skyType]
    
    -- Hide original sky
    if originalSky then
        originalSky.Parent = nil
    end
    
    -- Create custom sky
    customSkyInstance = Instance.new("Sky")
    customSkyInstance.SkyboxBk = preset.SkyboxBk
    customSkyInstance.SkyboxDn = preset.SkyboxDn
    customSkyInstance.SkyboxFt = preset.SkyboxFt
    customSkyInstance.SkyboxLf = preset.SkyboxLf
    customSkyInstance.SkyboxRt = preset.SkyboxRt
    customSkyInstance.SkyboxUp = preset.SkyboxUp
    customSkyInstance.StarCount = preset.StarCount
    customSkyInstance.SunAngularSize = preset.SunAngularSize
    customSkyInstance.MoonAngularSize = preset.MoonAngularSize
    customSkyInstance.Parent = Lighting
    
    -- Apply lighting settings
    if preset.ClockTime then
        Lighting.ClockTime = preset.ClockTime
    end
    if preset.Ambient then
        Lighting.Ambient = preset.Ambient
        Lighting.OutdoorAmbient = preset.Ambient
    end
end

