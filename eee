            fov_circle.Position = getMousePosition()
        else
            fov_circle.Visible = false
        end
    end)
end)

-- Silent Aim Hook (Uses cached target - NO function calls inside hook)
-- Silent Aim Hook (Uses cached target - NO function calls inside hook)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local method = getnamecallmethod()
    
    -- Quick exit for non-Raycast (99% of calls)
    if method ~= "Raycast" then
        return oldNamecall(...)
    end
    
    -- Quick exit if disabled
    if not Settings.SilentAimEnabled then
        return oldNamecall(...)
    end
    
    local args = {...}
    local self = args[1]
    
    -- Only workspace raycasts
    if self ~= workspace then
        return oldNamecall(...)
    end
    
    -- Don't hook our own calls
    if checkcaller() then
        return oldNamecall(...)
    end
    
    -- Need at least origin and direction
    if #args < 3 then
        return oldNamecall(...)
    end
    
    -- Must be Vector3 arguments
    if typeof(args[2]) ~= "Vector3" or typeof(args[3]) ~= "Vector3" then
        return oldNamecall(...)
    end
    
    -- Use cached target (set by render loop)
    local target = cachedTarget
    if not target then
        return oldNamecall(...)
    end
    
    -- Hit chance (simple math, no function calls)
    local chance = math.random(1, 100)
    if chance > Settings.SilentAimHitChance then
        return oldNamecall(...)
    end
    
    -- Get target position safely
    local targetPos = target.Position
    if not targetPos then
        return oldNamecall(...)
    end
    
    -- Calculate new direction
    local origin = args[2]
    local newDir = (targetPos - origin).Unit * 1000
    
    -- Call with modified direction
    args[3] = newDir
    return oldNamecall(unpack(args))
end))

