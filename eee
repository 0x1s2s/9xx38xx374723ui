-- OPTIMIZED: Use HRP and Head for proper bounding box
local function getBoundingBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hrp then return nil end
    
    local rootPos, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not rootOnScreen then return nil end
    
    -- Get head position for proper height calculation
    local topY, bottomY = rootPos.Y, rootPos.Y
    
    if head then
        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        if headOnScreen then
            topY = headPos.Y
        end
    end
    
    -- Get foot position estimate (3 studs below HRP)
    local footPos, footOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    if footOnScreen then
        bottomY = footPos.Y
    end
    
    -- Calculate actual box dimensions from world positions
    local boxHeight = math.abs(bottomY - topY)
    local boxWidth = boxHeight * 0.6
    
    -- Minimum size check
    if boxHeight < 10 then return nil end
    
    local size = Vector2.new(boxWidth, boxHeight)
    local centerY = (topY + bottomY) / 2
    local pos = Vector2.new(rootPos.X, centerY)
    return {Position = pos, Size = size}
end

-- ESP Frame Skip Counter (update every 2 frames for performance)
local espFrameCounter = 0
local ESP_SKIP_FRAMES = 2

-- Optimized: Heartbeat + Frame Skipping for ESP
RunService.Heartbeat:Connect(function()
    -- Frame skip for performance
    espFrameCounter = espFrameCounter + 1
    if espFrameCounter < ESP_SKIP_FRAMES then return end
    espFrameCounter = 0
    
    if not Settings.ESPEnabled then
        for _, items in pairs(Drawings) do
            for k, d in pairs(items) do
                if k == "Highlight" and d then
                    d.Enabled = false
                elseif k == "Chams" and type(d) == "table" then
                    for _, adorn in pairs(d) do
                        if adorn and adorn.Destroy then pcall(function() adorn:Destroy() end) end
                    end
                    items.Chams = {}
                elseif d and d.Visible ~= nil then
                    d.Visible = false
                end
            end
        end
        return
    end

    for player, items in pairs(Drawings) do
        local char = player.Character
        if char and (not Settings.TeamCheck or player.Team ~= LocalPlayer.Team) then
            -- Check render distance
            local root = char:FindFirstChild("HumanoidRootPart")
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local distanceInRange = true
            
            if root and myRoot then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist > Settings.ESPRenderDistance then
                    distanceInRange = false
                    -- Out of range - hide all ESP elements
                    for k,d in pairs(items) do
                        if k=="Highlight" and d then d.Enabled=false
                        elseif k=="Chams" and type(d)=="table" then
                            for _,adorn in pairs(d) do if adorn and adorn.Destroy then pcall(function() adorn:Destroy() end) end end
                            items.Chams={}
                        elseif k=="Tracer" and d then d.Visible=false
                        elseif d and d.Visible~=nil then d.Visible=false end
                    end
                end
            end
            
            if distanceInRange then
                local bbox = getBoundingBox(char)
                local humanoid = char:FindFirstChild("Humanoid")
                if bbox and humanoid then
                    local color = (Settings.TeamColor and player.TeamColor and player.TeamColor.Color) or Settings.VisualColor

                    if Settings.ShowBox then
                        items.Box.Position = Vector2.new(bbox.Position.X - bbox.Size.X/2, bbox.Position.Y - bbox.Size.Y/2)
                        items.Box.Size = bbox.Size
                        items.Box.Color = color
                        items.Box.Visible = true
                    else
                        items.Box.Visible = false
                    end

                    if Settings.ChamsEnabled and not Settings.HighlightEnabled then
                        if not items.Chams then items.Chams = {} end
                        if #items.Chams == 0 then
                            -- Get all BaseParts in character (optimized - GetChildren, not GetDescendants)
                            for _, part in pairs(char:GetChildren()) do
                                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
                                    local adorn = Instance.new("BoxHandleAdornment")
                                    adorn.Adornee = part
                                    adorn.AlwaysOnTop = true
                                    adorn.ZIndex = 10
                                    adorn.Size = part.Size
                                    adorn.Color3 = color
                                    adorn.Transparency = Settings.ChamsTransparency
                                    adorn.Parent = game:GetService("CoreGui")
                                    table.insert(items.Chams, adorn)
                                end
                            end
                        else
                            -- Update colors on existing chams
                            for _, adorn in pairs(items.Chams) do
                                if adorn and adorn.Color3 then
                                    adorn.Color3 = color
                                end
                            end
                        end
                    elseif items.Chams then
                        for _, adorn in pairs(items.Chams) do
                            if adorn and adorn.Destroy then pcall(function() adorn:Destroy() end) end
                        end
                        items.Chams = {}
                    end

                    if Settings.HighlightEnabled and items.Highlight then
                        items.Highlight.Adornee = char
                        items.Highlight.FillColor = color
                        items.Highlight.OutlineColor = color
                        items.Highlight.FillTransparency = Settings.HighlightFillTransparency
                        items.Highlight.OutlineTransparency = Settings.HighlightOutlineTransparency
                        items.Highlight.Enabled = true
                    elseif items.Highlight then
                        items.Highlight.Enabled = false
                    end

                    if Settings.ShowHealth then
                        local hpPercent = math.clamp(humanoid.Health/humanoid.MaxHealth,0,1)
                        items.Health.Color = Color3.new(1-hpPercent, hpPercent, 0)
                        items.Health.Position = Vector2.new(bbox.Position.X - bbox.Size.X/2 - HealthBarWidth - 2, bbox.Position.Y - bbox.Size.Y/2)
                        items.Health.Size = Vector2.new(HealthBarWidth, bbox.Size.Y * hpPercent)
                        items.Health.Visible = true
                    else
                        items.Health.Visible = false
                    end

                    if Settings.ShowName then
                        local displayName = Settings.UseDisplayName and player.DisplayName or player.Name
                        items.Name.Position = Vector2.new(bbox.Position.X, bbox.Position.Y - bbox.Size.Y/2 - NameOffset)
                        items.Name.Text = displayName
                        items.Name.Color = color
                        items.Name.Visible = true
                    else
                        items.Name.Visible = false
                    end

                    local toolName = ""
                    if Settings.ShowEquippedItem then
                        for _, tool in ipairs(char:GetChildren()) do
                            if tool:IsA("Tool") then
                                toolName = tool.Name
                                break
                            end
                        end
                        items.Item.Text = toolName ~= "" and toolName or ""
                        items.Item.Position = Vector2.new(bbox.Position.X, bbox.Position.Y + bbox.Size.Y/2 + EquippedYOffset)
                        items.Item.Color = color
                        items.Item.Visible = toolName ~= ""
                    else
                        items.Item.Visible = false
                    end

                    if Settings.ShowDistance then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if root and myRoot then
                            local dist = (root.Position - myRoot.Position).Magnitude
                            items.Distance.Text = string.format("%.0f studs", dist)
                            local distY = bbox.Position.Y + bbox.Size.Y/2 + (Settings.ShowEquippedItem and toolName~="" and DistanceYOffset or DistanceYOffsetNoEquipped)
